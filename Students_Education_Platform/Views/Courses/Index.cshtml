@model IEnumerable<Students_Education_Platform.Models.Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h1 class="fw-bold text-dark-800"><i class="fas fa-book-open text-primary me-2"></i>Courses Catalog</h1>
            <p class="text-muted small">Manage available training programs and classes</p>
        </div>
        <a href="~/Courses/Create" class="btn btn-primary px-4 py-2 rounded-3 fw-bold shadow-sm hover-translate-y">
            <i class="fas fa-plus-circle me-2"></i>Create New Course
        </a>
    </div>

    <!-- Glass Table Card -->
    <div class="glass-card shadow-sm border-0 rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.5) !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary fw-semibold text-uppercase small" style="border-bottom: 2px solid #e2e8f0;">
                    <tr>
                        <th class="px-4 py-3">ID</th>
                        <th class="px-4 py-3">Course Name</th>
                        <th class="px-4 py-3">Duration</th>
                        <th class="px-4 py-3">Department</th>
                        <th class="px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="text-dark-700">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open fa-3x mb-3 text-secondary"></i>
                                <p class="fw-semibold">No courses found</p>
                                <a href="~/Courses/Create" class="btn btn-sm btn-outline-primary">Add your first course</a>
                            </td>
                        </tr>
                    }
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td class="px-4 py-3.5 fw-bold text-secondary">#@course.Id</td>
                            <td class="px-4 py-3.5 font-semibold text-dark fs-5">@course.CourseName</td>
                            <td class="px-4 py-3.5">
                                <span class="badge bg-soft-info text-info rounded-pill px-3 py-1.5 fw-bold">
                                    <i class="far fa-clock me-1"></i>@course.Duration Hrs
                                </span>
                            </td>
                            <td class="px-4 py-3.5">
                                <span class="badge bg-soft-primary text-primary px-3 py-1.5 fw-bold rounded-2">
                                    <i class="fas fa-university me-1"></i>@(course.Department?.DeptName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="px-4 py-3.5 text-end">
                                <a href="~/Courses/Details?id=@course.Id" class="btn btn-sm btn-light text-secondary rounded-2 me-1 border shadow-xs" title="View Details">
                                    <i class="fas fa-eye text-primary"></i>
                                </a>
                                <a href="~/Courses/Edit?id=@course.Id" class="btn btn-sm btn-light text-secondary rounded-2 me-1 border shadow-xs" title="Edit Course">
                                    <i class="fas fa-edit text-warning"></i>
                                </a>
                                <a href="~/Courses/Delete?id=@course.Id" class="btn btn-sm btn-light text-secondary rounded-2 border shadow-xs" title="Delete Course">
                                    <i class="fas fa-trash-alt text-danger"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary {
        background-color: rgba(59, 130, 246, 0.12) !important;
    }
    .bg-soft-info {
        background-color: rgba(6, 182, 212, 0.12) !important;
    }
    .hover-translate-y {
        transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .hover-translate-y:hover {
        transform: translateY(-2px);
    }
    .glass-card {
        transition: box-shadow 0.3s ease;
    }
    .glass-card:hover {
        box-shadow: 0 10px 30px rgba(0,0,0,0.04) !important;
    }
</style>
