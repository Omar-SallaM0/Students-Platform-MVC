@model Students_Education_Platform.Models.Course
@{
    ViewData["Title"] = "Course Details";
}

<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <a href="~/Courses/Index" class="btn btn-outline-secondary btn-sm rounded-circle p-2 me-3" style="width: 38px; height: 38px;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h2 class="fw-bold mb-0">Course Blueprint</h2>
            <p class="text-muted small mb-0">Detailed schema and exams linked to this course</p>
        </div>
    </div>

    <div class="row">
        <!-- Main Course Info Card -->
        <div class="col-lg-5 mb-4">
            <div class="glass-card shadow-sm p-4 border-0 rounded-4" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.4) !important;">
                <div class="text-center py-3">
                    <div class="d-inline-block p-3 rounded-circle bg-primary text-white mb-3 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="fas fa-book-reader fa-xl"></i>
                    </div>
                    <h3 class="fw-bold">@Model.CourseName</h3>
                    <p class="text-muted small">Course ID: #@Model.Id</p>
                </div>

                <hr class="my-4" style="border-top: 1px solid #e2e8f0;" />

                <div class="mb-3 d-flex justify-content-between align-items-center">
                    <span class="text-secondary fw-semibold small">Department:</span>
                    <span class="badge bg-soft-primary text-primary px-3 py-1.5 fw-bold rounded-2">
                        <i class="fas fa-university me-1"></i>@(Model.Department?.DeptName ?? "Unassigned")
                    </span>
                </div>

                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <span class="text-secondary fw-semibold small">Duration:</span>
                    <span class="badge bg-soft-info text-info px-3 py-1.5 fw-bold rounded-pill">
                        <i class="far fa-clock me-1"></i>@Model.Duration Hours
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <a href="~/Courses/Edit?id=@Model.Id" class="btn btn-warning text-white fw-bold rounded-3 w-50 py-2 shadow-sm">
                        <i class="fas fa-edit me-2"></i>Edit
                    </a>
                    <a href="~/Courses/Delete?id=@Model.Id" class="btn btn-outline-danger fw-bold rounded-3 w-50 py-2">
                        <i class="fas fa-trash-alt me-2"></i>Delete
                    </a>
                </div>
            </div>
        </div>

        <!-- Associated Exams Section -->
        <div class="col-lg-7">
            <div class="glass-card shadow-sm p-4 border-0 rounded-4" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.4) !important;">
                <h4 class="fw-bold mb-4 text-dark-800 d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-file-signature text-secondary me-2"></i>Linked Exams</span>
                    <span class="badge bg-secondary rounded-pill small">@Model.Exams.Count</span>
                </h4>

                @if (!Model.Exams.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-scroll fa-3x mb-3 text-secondary"></i>
                        <p class="mb-0 fw-semibold">No exams scheduled for this course</p>
                        <p class="text-muted small mb-3">Exams can be scheduled via the Exams Panel</p>
                        <a href="~/Exam/Create" class="btn btn-sm btn-outline-primary rounded-3"><i class="fas fa-plus me-1"></i>Create Exam</a>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var exam in Model.Exams)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3.5 px-0 border-slate-200">
                                <div>
                                    <h6 class="fw-bold mb-1">@exam.Title</h6>
                                    <span class="text-muted small"><i class="far fa-calendar-alt me-1"></i>@exam.Date.ToString("MMMM dd, yyyy @ hh:mm tt")</span>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-soft-success text-success px-3 py-1.5 fw-bold rounded-pill">
                                        Max Score: @exam.FullMark
                                    </span>
                                    <a href="~/Exam/Details?id=@exam.Id" class="btn btn-sm btn-light border p-2 rounded-2" title="View Exam Details">
                                        <i class="fas fa-chevron-right text-muted"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary {
        background-color: rgba(59, 130, 246, 0.12) !important;
    }
    .bg-soft-info {
        background-color: rgba(6, 182, 212, 0.12) !important;
    }
    .bg-soft-success {
        background-color: rgba(16, 185, 129, 0.12) !important;
    }
    .glass-card {
        min-height: 380px;
    }
</style>
