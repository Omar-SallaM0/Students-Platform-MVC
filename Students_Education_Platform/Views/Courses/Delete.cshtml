@model Students_Education_Platform.Models.Course
@{
    ViewData["Title"] = "Delete Course";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="glass-card shadow-lg p-5 border-0 rounded-4 text-center" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.4) !important;">
                
                <div class="d-inline-block p-3 rounded-circle bg-danger text-white mb-4 shadow-sm" style="width: 70px; height: 70px;">
                    <i class="fas fa-exclamation-triangle fa-2x animate-bounce"></i>
                </div>

                <h2 class="fw-bold text-dark-800 mb-2">Delete Course?</h2>
                <p class="text-secondary small mb-4">Are you absolutely sure you want to permanently delete this course? This action cannot be undone.</p>

                <div class="bg-light p-4 rounded-3 text-start mb-4 border border-slate-200">
                    <div class="mb-2 d-flex justify-content-between align-items-center">
                        <span class="text-secondary small fw-semibold">Course Title:</span>
                        <span class="fw-bold">@Model.CourseName</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between align-items-center">
                        <span class="text-secondary small fw-semibold">Duration:</span>
                        <span class="fw-bold">@Model.Duration Hours</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-secondary small fw-semibold">Department:</span>
                        <span class="fw-bold">@(Model.Department?.DeptName ?? "Unassigned")</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex gap-3 justify-content-center">
                        <a href="~/Courses/Index" class="btn btn-light px-4 py-2.5 rounded-3 fw-bold border w-50">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 py-2.5 rounded-3 fw-bold shadow-sm w-50">
                            Yes, Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        transition: transform 0.3s ease;
    }
    .glass-card:hover {
        transform: scale(1.01);
    }
</style>
