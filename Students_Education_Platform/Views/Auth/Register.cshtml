@model Students_Education_Platform.Models.Student
@{
    ViewData["Title"] = "Register";
    var activeTab = ViewBag.ActiveTab as string ?? "student";
}

<div class="auth-wrapper d-flex justify-content-center align-items-center min-vh-100 py-5">
    <div class="glass-card shadow-lg p-5 border-0 rounded-4 w-100" style="max-width: 580px; backdrop-filter: blur(16px); background: rgba(255, 255, 255, 0.8); border: 1px solid rgba(255, 255, 255, 0.4) !important;">
        
        <div class="text-center mb-4">
            <div class="logo-box mb-3 d-inline-block p-3 rounded-circle bg-success text-white shadow-sm" style="width: 70px; height: 70px;">
                <i class="fas fa-user-plus fa-2x"></i>
            </div>
            <h2 class="fw-bold text-dark-800">Create Account</h2>
            <p class="text-muted small">Join the Students Platform and track your academic milestones</p>
        </div>

        <!-- Custom tabs to select Registration Type -->
        <div class="tabs-container bg-light p-1 rounded-3 mb-4 d-flex justify-content-between position-relative" style="border: 1px solid #e2e8f0;">
            <button type="button" class="btn tab-btn w-50 py-2 rounded-2 fw-semibold @(activeTab == "student" ? "btn-success text-white" : "text-secondary")" id="studentRegTabBtn" onclick="switchRegTab('student')">
                <i class="fas fa-graduation-cap me-2"></i>Student Signup
            </button>
            <button type="button" class="btn tab-btn w-50 py-2 rounded-2 fw-semibold @(activeTab == "admin" ? "btn-success text-white" : "text-secondary")" id="adminRegTabBtn" onclick="switchRegTab('admin')">
                <i class="fas fa-user-cog me-2"></i>Admin Signup
            </button>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-center mb-4 border-0 rounded-3 text-danger shadow-sm" style="background-color: #fee2e2;">
                <i class="fas fa-exclamation-circle me-2 fs-5"></i>
                <div class="small fw-medium">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            </div>
        }

        <!-- STUDENT REGISTRATION FORM -->
        <div id="studentFormContainer" class="@(activeTab == "student" ? "" : "d-none")">
            <form asp-action="RegisterStudent" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary small">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-user text-muted"></i></span>
                            <input type="text" name="Name" class="form-control border-start-0 py-2" placeholder="John Doe" required />
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary small">Age (20 - 60)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-calendar-alt text-muted"></i></span>
                            <input type="number" name="Age" class="form-control border-start-0 py-2" placeholder="22" min="20" max="60" required />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-map-marker-alt text-muted"></i></span>
                        <input type="text" name="Address" class="form-control border-start-0 py-2" placeholder="Cairo, Egypt" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                        <input type="email" name="Email" class="form-control border-start-0 py-2" placeholder="john@example.com" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary small">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                            <input type="password" name="Password" class="form-control border-start-0 py-2" placeholder="••••••••" required />
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold text-secondary small">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                            <input type="password" name="ConfirmPassword" class="form-control border-start-0 py-2" placeholder="••••••••" required />
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary small">Department</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-university text-muted"></i></span>
                        <select name="DeptId" class="form-select border-start-0 py-2" required>
                            <option value="">Select Department</option>
                            @foreach (var dept in ViewBag.Departments as List<Department>)
                            {
                                <option value="@dept.Id">@dept.DeptName</option>
                            }
                        </select>
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2.5 rounded-3 fw-bold shadow-sm transition-all hover-translate-y">
                    Register as Student
                </button>
            </form>
        </div>

        <!-- ADMIN/USER REGISTRATION FORM -->
        <div id="adminFormContainer" class="@(activeTab == "admin" ? "" : "d-none")">
            <form asp-action="RegisterUser" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-user-shield text-muted"></i></span>
                        <input type="text" name="Name" class="form-control border-start-0 py-2" placeholder="admin_user" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                        <input type="email" name="Email" class="form-control border-start-0 py-2" placeholder="admin@example.com" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-semibold text-secondary small">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                            <input type="password" name="Password" class="form-control border-start-0 py-2" placeholder="••••••••" required />
                        </div>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label class="form-label fw-semibold text-secondary small">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="fas fa-lock text-muted"></i></span>
                            <input type="password" name="ConfirmPassword" class="form-control border-start-0 py-2" placeholder="••••••••" required />
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2.5 rounded-3 fw-bold shadow-sm transition-all hover-translate-y">
                    Register as Admin
                </button>
            </form>
        </div>

        <div class="text-center mt-4">
            <span class="text-muted small">Already have an account?</span>
            <a href="~/Auth/Login" class="text-success small fw-semibold text-decoration-none ms-1">Login here</a>
        </div>
    </div>
</div>

<style>
    .glass-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .glass-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08) !important;
    }
    .tab-btn {
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        border: none !important;
    }
    .hover-translate-y {
        transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .hover-translate-y:hover {
        transform: translateY(-2px);
    }
    .input-group-text {
        color: #94a3b8;
    }
    .form-control:focus, .form-select:focus {
        border-color: #10b981 !important;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15) !important;
    }
</style>

<script>
    function switchRegTab(tab) {
        const studentBtn = document.getElementById('studentRegTabBtn');
        const adminBtn = document.getElementById('adminRegTabBtn');
        const studentForm = document.getElementById('studentFormContainer');
        const adminForm = document.getElementById('adminFormContainer');

        if (tab === 'student') {
            studentBtn.className = "btn tab-btn w-50 py-2 rounded-2 fw-semibold btn-success text-white";
            adminBtn.className = "btn tab-btn w-50 py-2 rounded-2 fw-semibold text-secondary";
            studentForm.classList.remove('d-none');
            adminForm.classList.add('d-none');
        } else {
            studentBtn.className = "btn tab-btn w-50 py-2 rounded-2 fw-semibold text-secondary";
            adminBtn.className = "btn tab-btn w-50 py-2 rounded-2 fw-semibold btn-success text-white";
            studentForm.classList.add('d-none');
            adminForm.classList.remove('d-none');
        }
    }
</script>
