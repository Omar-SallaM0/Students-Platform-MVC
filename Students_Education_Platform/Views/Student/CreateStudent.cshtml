@model Student
@{
    ViewData["Title"] = "CreateStudent";
    SelectList deptOptions = new SelectList(ViewBag.DeptList, "Id", "DeptName");
}

<h1>Create Student</h1>
 <div asp-validation-summary="ModelOnly" class="text-danger ms-5"></div>

<form asp-action="addstd" asp-controller="Student" method ="post" class="w-50 mx-auto mt-4">
    @* PersonName *@
        <div class="form-field flex">
                <div class="flex-1">
                    <label asp-for="Name" class="form-label"></label>

                </div>
                <div class="flex-1">
                     <input asp-for="Name"  class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>

                </div>
        </div>
        <br />
    @* Age *@
        <div class="form-field flex">
                <div class="flex-1">
                <label asp-for="Age" class="form-label"></label>
                </div>
                <div class="flex-1">
                <input asp-for="Age" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>

                </div>
        </div>
        <br />
    @* Address *@
         <div class="form-field flex">
                <div class="flex-1">
                    <label asp-for="Address" class="form-label"></label>
                </div>
                <div class="flex-1">
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>

                </div>
        </div>
        <br />
    @* Email *@
        <div class="form-field flex">
                <div class="flex-1">
                    <label asp-for="Email" class="form-label"></label>
                </div>
                <div class="flex-1">
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
                </div>
        </div>
        <br />
    @* Password *@
        <div class="form-field flex">
                <div class="flex-1">
                    <label asp-for="Password" class="form-label"></label>
                </div>
                <div class="flex-1">
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>

                </div>
        </div>
        <br />
    @* ConfirmPassword *@
       <div class="form-field flex">
                <div class="flex-1">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                </div>
                <div class="flex-1">
                <input asp-for="ConfirmPassword" class="form-control" />

                </div>
        </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger padding-left w-30"></span>
        <br />
        <br />
    @* Department Id *@
        <div class="form-field flex"> 
             <div class="flex-1">
            <label asp-for="DeptId" class="form-label">Department ID</label>
             </div>
             <div class="flex-1">
                 <select asp-items="deptOptions" asp-for="DeptId" class="form-control">

                    <option value="">--select Department--</option>

                </select>
                <span asp-validation-for="DeptId" class="text-danger"></span>

             </div>
        </div>

        <br />

        <div class="d-flex gap-2">
        <input type="submit" value="Add" class="btn btn-success" />
        <a href="/Student/getall" class="btn btn-secondary">Cancel</a>
        </div>

</form>

<a href="~/Student/getall" class ="linl-hover btn btn-dark">Back To Home</a>
