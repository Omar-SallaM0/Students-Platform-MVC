@model IEnumerable<Students_Education_Platform.Models.Exam>
@{
    ViewData["Title"] = "Exams";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <div>
            <h1 class="fw-bold text-dark-800"><i class="fas fa-file-signature text-success me-2"></i>Exams Schedule</h1>
            <p class="text-muted small">Manage schedules, maximum scores, and milestones</p>
        </div>
        <a href="~/Exam/Create" class="btn btn-success px-4 py-2 rounded-3 fw-bold shadow-sm text-white hover-translate-y">
            <i class="fas fa-plus-circle me-2"></i>Create New Exam
        </a>
    </div>

    <!-- Glass Table Card -->
    <div class="glass-card shadow-sm border-0 rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.5) !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary fw-semibold text-uppercase small" style="border-bottom: 2px solid #e2e8f0;">
                    <tr>
                        <th class="px-4 py-3">ID</th>
                        <th class="px-4 py-3">Exam Title</th>
                        <th class="px-4 py-3">Course</th>
                        <th class="px-4 py-3">Exam Date & Time</th>
                        <th class="px-4 py-3">Full Mark</th>
                        <th class="px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="text-dark-700">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-scroll fa-3x mb-3 text-secondary"></i>
                                <p class="fw-semibold">No exams found</p>
                                <a href="~/Exam/Create" class="btn btn-sm btn-outline-success">Add your first exam</a>
                            </td>
                        </tr>
                    }
                    @foreach (var exam in Model)
                    {
                        <tr>
                            <td class="px-4 py-3.5 fw-bold text-secondary">#@exam.Id</td>
                            <td class="px-4 py-3.5 font-semibold text-dark fs-5">@exam.Title</td>
                            <td class="px-4 py-3.5">
                                <span class="badge bg-soft-primary text-primary px-3 py-1.5 fw-bold rounded-2">
                                    <i class="fas fa-book me-1"></i>@(exam.Course?.CourseName ?? "Unassigned")
                                </span>
                            </td>
                            <td class="px-4 py-3.5">
                                <span class="text-dark-800 fw-medium">
                                    <i class="far fa-calendar-alt text-muted me-1.5"></i>@exam.Date.ToString("MMMM dd, yyyy @ hh:mm tt")
                                </span>
                            </td>
                            <td class="px-4 py-3.5">
                                <span class="badge bg-soft-success text-success rounded-pill px-3 py-1.5 fw-bold">
                                    Max Score: @exam.FullMark
                                </span>
                            </td>
                            <td class="px-4 py-3.5 text-end">
                                <a href="~/Exam/Details?id=@exam.Id" class="btn btn-sm btn-light text-secondary rounded-2 me-1 border shadow-xs" title="View Details">
                                    <i class="fas fa-eye text-primary"></i>
                                </a>
                                <a href="~/Exam/Edit?id=@exam.Id" class="btn btn-sm btn-light text-secondary rounded-2 me-1 border shadow-xs" title="Edit Exam">
                                    <i class="fas fa-edit text-warning"></i>
                                </a>
                                <a href="~/Exam/Delete?id=@exam.Id" class="btn btn-sm btn-light text-secondary rounded-2 border shadow-xs" title="Delete Exam">
                                    <i class="fas fa-trash-alt text-danger"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary {
        background-color: rgba(59, 130, 246, 0.12) !important;
    }
    .bg-soft-success {
        background-color: rgba(16, 185, 129, 0.12) !important;
    }
    .hover-translate-y {
        transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .hover-translate-y:hover {
        transform: translateY(-2px);
    }
    .glass-card {
        transition: box-shadow 0.3s ease;
    }
    .glass-card:hover {
        box-shadow: 0 10px 30px rgba(0,0,0,0.04) !important;
    }
</style>
