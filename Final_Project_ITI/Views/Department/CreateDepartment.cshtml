@model Department
@{
    ViewData["Title"] = "CreateDepartment";
}
<h1>Create Department</h1>


 <form asp-action="addDept" asp-controller="Department" method ="post" class="w-50 mx-auto mt-4">
    @* Department Name *@
        <div class="form-field flex">
                <div class="flex-1">
                    <label asp-for="DeptName" class="form-label">Department Name</label>

                </div>
                <div class="flex-1">
                     <input asp-for="DeptName"  class="form-control" />
                </div>
        </div>
        <br />

        <div class="d-flex gap-2">
        <input type="submit" value="Add" class="btn btn-success" />
        <a href="/home/getall" class="btn btn-secondary">Cancel</a>
        </div>

</form>

<a href="~/Department/getallDepartment" class ="linl-hover btn btn-dark">Back To Home</a>